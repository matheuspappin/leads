{
  "name": "lead-hunter-desktop",
  "version": "1.0.0",
  "description": "Lead Hunter Desktop App using Playwright",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win"
  },
